# Copy to .env and fill in. .env is gitignored — never commit real cookies.
#
# Optional. Many Shopee endpoints return empty payloads to anonymous callers.
# To obtain: log in to shopee.co.id in your browser, open DevTools > Application >
# Cookies, and copy the full cookie header value for the shopee.co.id domain.
#
# Leave blank to run fully anonymous.
SHOPEE_COOKIE=

# Requests per second. Lower is safer. Default 1.0.
SHOPEE_RATE=1.0
